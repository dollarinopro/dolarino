{
  "manifest_version": 3,
  "name": "Dollarino — پایانه و رادار هوشمند دلارینو",
  "short_name": "Dollarino",
  "version": "9.7.1",
  "description": "Apple Liquid-Glass Trading Companion matching Dollarino Web: Live Bot Control, Hero Equity Card, AI Scan, Markets, DEX & Trust Wallet Radar.",
  "icons": {
    "48": "icons/icon-192.png",
    "128": "icons/icon-192.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "دلارینو | ترمینال سریع و هوشمند",
    "default_icon": {
      "48": "icons/icon-192.png",
      "128": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://*.pages.dev/*",
    "https://*.workers.dev/*",
    "https://api.dexscreener.com/*",
    "https://api.geckoterminal.com/*",
    "https://api.coinbase.com/*"
  ]
}
