# ==============================================================================
# Dollarino (دلارینو) — Environment & Cloudflare Secrets Template
# NEVER commit a real .env or .dev.vars file to Git!
# For production on Cloudflare, use: `npx wrangler secret put <KEY>`
# ==============================================================================

# --- Core Auth & Vault Encryption (REQUIRED) ---
SESSION_JWT_SECRET=replace_with_64_char_random_hex
MASTER_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# --- Instance Owner & Telegram Admin ---
# Numeric Telegram ID of the primary instance owner (for Telegram Admin Panel)
OWNER_TELEGRAM_ID=944021185
DEFAULT_SIGNAL_CHANNEL=@Dollarino_official
PUBLIC_WEB_URL=https://dollarino.pages.dev

# --- AI Gateway (Hilinkup / DeepSeek / OpenAI-compatible) ---
HILINKUP_API_KEY=replace_with_your_hilinkup_api_key
HILINKUP_BASE_URL=https://api.hilinkup.com/v1
HILINKUP_MODEL=baidu/deepseek-v4.1-flash-1017

# --- Optional: Global Instance Telegram Bot (each user can also add their own bot in UI) ---
# IMPORTANT: Generate a fresh token in @BotFather and NEVER commit it to Git!
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret

# --- Safety Guardrails ---
ALLOW_LIVE_TRADING=false
MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MARGIN_PCT=10.0
MIN_RISK_REWARD=1.0
DAILY_MAX_LOSS_PCT=5.0
